/* pages/DIR/DIR.wxss */
.page-container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
}
.header {
  padding: 32rpx;
  background: linear-gradient(135deg, #1976D2 0%, #42A5F5 100%);
}
.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
}
.content {
  flex: 1;
  padding: 32rpx;
}
.section {
  margin-bottom: 32rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}
