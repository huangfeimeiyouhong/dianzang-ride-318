/* pages/profile/profile.wxss - 个人中心样式 */

.page-container {
  width: 100%;
  min-height: 100vh;
  background: linear-gradient(180deg, #E3F2FD 0%, #BBDEFB 100%);
  padding-bottom: 176rpx;
}

/* 顶部状态栏 */
.status-bar {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 24rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: sticky;
  top: 0;
  z-index: 100;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from { transform: translateY(-100%); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.energy-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #FFF9C4 0%, #FFE082 100%);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 193, 7, 0.3);
}

.energy-icon {
  width: 48rpx;
  height: 48rpx;
  background: #FF6B35;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  animation: energyPulse 2s ease-in-out infinite;
}

@keyframes energyPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

.energy-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #E65100;
  transition: transform 0.3s ease;
}

.energy-value.animate {
  animation: valueJump 0.5s ease-out;
}

@keyframes valueJump {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); color: #FF6B35; }
  100% { transform: scale(1); }
}

.level-badge {
  background: linear-gradient(135deg, #5BB5A2 0%, #4CAF8A 100%);
  color: white;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  animation: badgeAppear 0.6s ease-out 0.3s both;
}

@keyframes badgeAppear {
  from { opacity: 0; transform: scale(0); }
  to { opacity: 1; transform: scale(1); }
}

/* 个人资料头部 */
.profile-header {
  background: linear-gradient(135deg, #5BB5A2 0%, #4CAF8A 100%);
  padding: 80rpx 40rpx 64rpx;
  text-align: center;
  color: white;
  position: relative;
  overflow: hidden;
  animation: headerSlide 0.8s ease-out 0.4s both;
}

@keyframes headerSlide {
  from { opacity: 0; transform: translateY(-60rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(10%, 10%); }
}

.avatar-container {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 32rpx;
}

.avatar {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 60rpx;
  height: 60rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.nickname {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  display: block;
}

.signature {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
}

/* 数据统计 */
.stats-section {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 32rpx;
  background: white;
  margin: -32rpx 32rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 10;
  animation: statsSlide 0.6s ease-out 0.6s both;
}

@keyframes statsSlide {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1976D2;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666666;
}

/* 功能菜单 */
.menu-section {
  background: white;
  border-radius: 24rpx;
  margin: 0 32rpx 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  animation: menuSlide 0.6s ease-out 0.8s both;
}

@keyframes menuSlide {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F5F5F5;
  transition: background 0.3s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F5F5F5;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 成就展示 */
.achievement-section {
  background: white;
  border-radius: 24rpx;
  margin: 0 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  animation: achievementSlide 0.6s ease-out 1s both;
}

@keyframes achievementSlide {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 24rpx;
  color: #1976D2;
}

.achievement-list {
  display: flex;
  gap: 24rpx;
  padding-bottom: 16rpx;
}

.achievement-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 160rpx;
}

.achievement-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.achievement-name {
  font-size: 20rpx;
  color: #666666;
  text-align: center;
}

/* Toast */
.toast {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%) translateY(-200rpx);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 24rpx 48rpx;
  border-radius: 96rpx;
  font-size: 28rpx;
  z-index: 1000;
  backdrop-filter: blur(20rpx);
  transition: transform 0.4s ease;
}

.toast.show {
  transform: translateX(-50%) translateY(0);
}
