/* components/hud/index.wxss  顶部状态栏 */
.hud {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 24rpx 12rpx;
  background: linear-gradient(180deg, rgba(10,22,40,0.95) 0%, rgba(10,22,40,0.6) 100%);
}

.hud-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.hud-value {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
}

.hud-unit {
  font-size: 20rpx;
  font-weight: 400;
  opacity: 0.7;
}

.hud-label {
  font-size: 20rpx;
  color: var(--text-muted);
  line-height: 1;
}

/* 迷你进度条 */
.hud-bar {
  width: 80rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255,255,255,0.08);
  margin-top: 6rpx;
  overflow: hidden;
}

.hud-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.hud-bar--energy {
  background: var(--accent);
}

.hud-bar--km {
  background: var(--accent2);
}

.hud-bar--mood {
  background: var(--success, #68d391);
}

.hud-bar--durability {
  background: var(--danger);
}
