/* components/station-card/index.wxss  站点信息卡片 */
.station-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: var(--bg-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--border);
  transition: all 0.3s ease;
}

.station-card--current {
  border-color: rgba(79, 209, 197, 0.4);
  background: rgba(79, 209, 197, 0.08);
}

.station-card--reached {
  opacity: 0.6;
}

/* 左侧 */
.station-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.station-icon {
  font-size: 48rpx;
  line-height: 1;
  flex-shrink: 0;
}

.station-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.station-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.station-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.station-km {
  color: var(--accent2);
}

.station-sep {
  opacity: 0.3;
}

.station-elev {
  color: var(--accent);
}

/* 右侧 */
.station-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

/* 骑友气泡 */
.rider-bubble {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx;
  background: rgba(246, 173, 85, 0.12);
  border-radius: 20rpx;
}

.rider-bubble-icon {
  font-size: 22rpx;
}

.rider-bubble-count {
  font-size: 22rpx;
  color: var(--accent2);
  font-weight: 600;
}

/* 状态标签 */
.station-badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.station-badge--current {
  background: rgba(79, 209, 197, 0.15);
  color: var(--accent);
}

.station-badge--reached {
  background: rgba(255, 255, 255, 0.06);
  color: var(--text-muted);
}
