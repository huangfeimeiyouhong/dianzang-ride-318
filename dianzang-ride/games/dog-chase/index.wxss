/* games/dog-chase/index.wxss  野狗追咬 */
.game-wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
}

.game-hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: linear-gradient(180deg, rgba(10,22,40,0.9) 0%, transparent 100%);
}

.hud-distance {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.hud-dist-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--accent);
  white-space: nowrap;
}

.hud-dist-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 6rpx;
  overflow: hidden;
  max-width: 300rpx;
}

.hud-dist-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), #38b2ac);
  border-radius: 6rpx;
  transition: width 0.15s ease;
}

.hud-dist--danger {
  background: linear-gradient(90deg, var(--danger), #e53e3e) !important;
}

.hud-timer {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent2);
  min-width: 60rpx;
  text-align: right;
}

.game-canvas {
  width: 100%;
  height: 100%;
}

.tap-hint {
  position: absolute;
  bottom: 200rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 30rpx;
  color: var(--accent);
  animation: hintPulse 1.2s ease-in-out infinite;
  z-index: 5;
}

@keyframes hintPulse {
  0%, 100% { opacity: 0.5; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.05); }
}

.game-result {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10,22,40,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 48rpx;
}

.result-btn {
  width: 400rpx;
}
