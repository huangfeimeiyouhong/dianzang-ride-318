/* 能量冲刺游戏样式 */
.container {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #0f0f23;
}

.game-canvas {
  position: absolute;
  top: 0;
  left: 0;
}

.hud {
  position: absolute;
  top: 20rpx;
  left: 0;
  right: 0;
  padding: 0 30rpx;
  z-index: 10;
}

.phase-box {
  text-align: center;
  margin-bottom: 20rpx;
}

.phase-label {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.phase-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
}

.energy-box {
  text-align: center;
  background: rgba(0,0,0,0.5);
  padding: 20rpx;
  border-radius: 20rpx;
}

.energy-value {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 15rpx;
}

.timer-box {
  text-align: center;
  margin-top: 20rpx;
}

.timer-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffd700;
}

/* 结果弹窗 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.8);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 100;
}

.result-content {
  background: #fff;
  border-radius: 30rpx;
  padding: 60rpx;
  text-align: center;
  min-width: 500rpx;
}

.result-content.win { border: 5rpx solid #27ae60; }
.result-content.lose { border: 5rpx solid #e74c3c; }

.result-emoji { font-size: 100rpx; display: block; margin-bottom: 20rpx; }
.result-title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 15rpx; }
.win .result-title { color: #27ae60; }
.lose .result-title { color: #e74c3c; }
.result-desc { font-size: 28rpx; color: #666; display: block; margin-bottom: 40rpx; }
.result-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff; border: none; border-radius: 50rpx;
  padding: 25rpx 80rpx; font-size: 32rpx;
}

/* 广告弹窗 */
.ad-modal {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.85);
  display: flex; justify-content: center; align-items: center;
  z-index: 100;
}

.ad-content {
  background: #fff; border-radius: 30rpx;
  padding: 60rpx; text-align: center; width: 600rpx;
}

.ad-title { font-size: 36rpx; font-weight: bold; display: block; margin-bottom: 40rpx; }
.ad-btn {
  background: #ffd700; color: #333; border: none; border-radius: 50rpx;
  padding: 25rpx 60rpx; font-size: 30rpx; margin-bottom: 20rpx;
}
.skip-btn { background: transparent; color: #999; border: none; font-size: 26rpx; }
