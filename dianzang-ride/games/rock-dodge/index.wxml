<!--games/rock-dodge/index.wxml  落石躲避关卡-->
<view class="game-wrap">
  <!-- HUD 顶栏 -->
  <view class="game-hud">
    <view class="hud-hp">
      <text class="hud-hp-label">HP</text>
      <view class="hud-hp-bar">
        <view class="hud-hp-fill" style="width:{{hpPct}}%"></view>
      </view>
    </view>
    <view class="hud-wave">第 {{wave}} / 3 波</view>
  </view>

  <!-- 游戏画布 -->
  <canvas
    type="2d"
    id="game-canvas"
    class="game-canvas"
    style="width:{{canvasW}}px;height:{{canvasH}}px"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
  ></canvas>

  <!-- 结算 -->
  <view class="game-result" wx:if="{{finished}}">
    <view class="result-icon">{{won ? '🎉' : '💥'}}</view>
    <view class="result-title">{{won ? '成功躲避！' : '被砸中了...'}}</view>
    <button class="btn btn-primary result-btn" bindtap="onBack">返回</button>
  </view>

  <!-- 广告弹窗 -->
  <ad-modal
    show="{{showAd}}"
    title="被落石砸倒"
    penalty="体能 -20，耐久 -5"
    bind:ad="onAdRevive"
    bind:skip="onAdSkip"
  />
</view>
