/* games/rock-dodge/index.wxss  落石躲避 */
.game-wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
}

/* HUD */
.game-hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: linear-gradient(180deg, rgba(10,22,40,0.9) 0%, transparent 100%);
}

.hud-hp {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.hud-hp-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--danger);
}

.hud-hp-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 6rpx;
  overflow: hidden;
  max-width: 300rpx;
}

.hud-hp-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--danger), #e53e3e);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.hud-wave {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
}

/* Canvas */
.game-canvas {
  width: 100%;
  height: 100%;
}

/* 结算 */
.game-result {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10,22,40,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 48rpx;
}

.result-btn {
  width: 400rpx;
}
