/* games/tire-fix/index.wxss  爆胎修补 */
.game-wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
}

.game-hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: linear-gradient(180deg, rgba(10,22,40,0.9) 0%, transparent 100%);
}

.hud-patches {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hud-patches-label {
  font-size: 24rpx;
  color: var(--text-muted);
}

.hud-patches-val {
  font-size: 28rpx;
  font-weight: 700;
}

.hud-timer {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent2);
  min-width: 60rpx;
  text-align: right;
}

.hud-timer--urgent {
  color: var(--danger);
  animation: timerFlash 0.5s ease-in-out infinite;
}

@keyframes timerFlash {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.game-canvas {
  width: 100%;
  height: 100%;
}

.game-result {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10,22,40,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 48rpx;
}

.result-btn {
  width: 400rpx;
}
