/* games/wind-balance/index.wxss  横风平衡 */
.game-wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: var(--bg);
  overflow: hidden;
}

/* HUD */
.game-hud {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 24rpx);
  background: linear-gradient(180deg, rgba(10,22,40,0.9) 0%, transparent 100%);
}

.hud-balance {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.hud-balance-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent);
}

.hud-balance-bar {
  flex: 1;
  height: 12rpx;
  background: rgba(255,255,255,0.08);
  border-radius: 6rpx;
  overflow: hidden;
  max-width: 300rpx;
}

.hud-balance-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.15s ease, background 0.3s ease;
}

.hud-timer {
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 700;
}

/* 风向提示 */
.wind-indicator {
  position: absolute;
  top: 100rpx;
  left: 0;
  right: 0;
  text-align: center;
  z-index: 10;
}

.wind-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  font-weight: 600;
  background: rgba(0,0,0,0.3);
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
}

/* Canvas */
.game-canvas {
  width: 100%;
  height: 100%;
}

/* 结算 */
.game-result {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(10,22,40,0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.result-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 48rpx;
}

.result-btn {
  width: 400rpx;
}
