.customize {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ========== 骑手预览 ========== */
.preview-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 32rpx;
}

.preview-bg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  transition: background 0.3s;
}

.preview-emoji {
  font-size: 100rpx;
  line-height: 1.2;
}

.preview-parts {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.part-helmet,
.part-jersey {
  font-size: 40rpx;
}

.preview-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ========== 滚动选项区 ========== */
.options-scroll {
  flex: 1;
  padding: 0 32rpx;
  overflow-y: auto;
}

.option-section {
  margin-bottom: 36rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.option-row {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.option-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  background: var(--bg-card);
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.option-item.selected {
  background: var(--bg-glass);
  transform: scale(1.05);
}

.option-item.locked {
  opacity: 0.4;
}

.option-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.option-name {
  font-size: 20rpx;
  color: var(--text-muted);
}

.lock-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
}

.bike-item {
  width: 200rpx;
}

/* ========== 颜色选择 ========== */
.color-row {
  display: flex;
  gap: 28rpx;
  flex-wrap: wrap;
}

.color-dot {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.color-dot.selected {
  transform: scale(1.2);
}

.color-check {
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.5);
}

/* ========== 底部按钮 ========== */
.bottom-bar {
  padding: 24rpx 48rpx 32rpx;
}

.go-btn {
  width: 100%;
  height: 96rpx;
  font-size: 34rpx;
  letter-spacing: 8rpx;
}
