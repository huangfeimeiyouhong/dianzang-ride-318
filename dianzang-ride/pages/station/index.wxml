<view class="station-page">
  <view class="close-btn" bindtap="onClose">✕</view>
  <view class="station-header">
    <view class="station-icon-wrap" style="background: radial-gradient(circle, var(--accent)22 0%, transparent 70%);">
      <text class="station-icon">{{station.icon}}</text>
    </view>
    <view class="station-name">{{station.name}}</view>
    <view class="station-meta">
      <view class="meta-item"><text class="meta-icon">📍</text><text>{{station.km}} km</text></view>
      <view class="meta-item"><text class="meta-icon">⛰️</text><text>海拔 {{station.elev}}m</text></view>
      <view class="meta-item" wx:if="{{station.dangerLevel > 0}}"><text class="meta-icon">⚠️</text><text>危险等级 {{station.dangerLevel}}</text></view>
    </view>
  </view>
  <view class="station-desc card">
    <view class="desc-title">站点介绍</view>
    <view class="desc-text">{{station.desc}}</view>
    <view class="desc-event"><text class="event-label">路况特征：</text><text>{{station.event}}</text></view>
  </view>

  <!-- 特色事件 -->
  <view wx:if="{{hasSpecialEvent}}" class="special-section card" bindtap="onSpecialEvent">
    <view class="special-inner">
      <text class="special-icon">⭐</text>
      <view class="special-info">
        <view class="special-title">{{specialEventName}}</view>
        <view class="special-hint">{{specialEventDesc}}</view>
      </view>
      <text class="special-arrow">›</text>
    </view>
  </view>

  <view class="rider-section card">
    <view class="section-header"><text class="section-title">🚴 骑友 ({{riders.length}})</text></view>
    <view wx:if="{{riders.length > 0}}" class="rider-list">
      <view wx:for="{{riders}}" wx:key="_id" class="rider-item">
        <view class="rider-avatar-wrap"><text class="rider-emoji">🚴</text></view>
        <view class="rider-info"><view class="rider-name">{{item.nickname || '匿名骑友'}}</view><view class="rider-title">{{item.title}}</view></view>
        <view class="rider-km">{{item.km}} km</view>
      </view>
    </view>
    <view wx:else class="empty-hint">暂无骑友在此站点</view>
  </view>

  <!-- 商店入口 -->
  <view wx:if="{{station.hasShop}}" class="shop-section card" bindtap="onShopToggle">
    <view class="shop-inner">
      <text class="shop-icon">🛒</text>
      <view class="shop-info">
        <view class="shop-title">补给商店</view>
        <view class="shop-hint">金币余额: {{coins}} 🪙</view>
      </view>
      <text class="shop-arrow {{showShop ? 'open' : ''}}">›</text>
    </view>
  </view>

  <!-- 商店内嵌列表 -->
  <view wx:if="{{showShop && shopItems.length > 0}}" class="shop-list">
    <view class="shop-list-title">可购买商品</view>
    <view wx:for="{{shopItems}}" wx:key="id" class="shop-item card">
      <view class="shop-item-left">
        <text class="shop-item-icon">{{item.icon}}</text>
        <view class="shop-item-info">
          <view class="shop-item-name">{{item.name}}</view>
          <view class="shop-item-desc">{{item.desc}}</view>
        </view>
      </view>
      <button class="btn {{item.owned ? 'btn-ghost owned-btn' : item.canAfford ? 'btn-primary buy-btn' : 'btn-ghost disabled-btn'}}"
        bindtap="onBuyItem" data-id="{{item.id}}"
        disabled="{{item.owned || !item.canAfford}}">
        {{item.owned ? '已拥有' : item.price + '🪙'}}
      </button>
    </view>
    <view wx:if="{{shopItems.length === 0}}" class="empty-hint">商店暂无商品</view>
  </view>
</view>
